# ===== Dependencies =====
node_modules/
tray/node_modules/

# ===== Portable Node runtime (tray offline bundle, not source) =====
node/

# ===== Agent private memory / runtime state (NEVER public) =====
.workbuddy/

# ===== Tool / analysis caches =====
.codegraph/
offline-cache/

# ===== Runtime data =====
data/
uploads/
backups/

# ===== Logs =====
*.log
server.log
server-test.log

# ===== Local env & secrets =====
.env
.env.local

# ===== Local MCP config (contains machine-specific absolute paths) =====
.mcp.json

# ===== Roundtable agent customization (UI prefs, travels with offline package) =====
agent-overrides.json

# ===== Scratch / dev artifacts (not part of the shipped product) =====
cmd.exe.lnk
.tmp-memtest/

# ===== OS junk =====
.DS_Store
Thumbs.db
nul

# ===== Generated caches / machine-specific registries (not source) =====
.cli-discovery-cache.json
cli-registry.json

# ===== Cloudflare Pages deploy artifact (deployed separately, not part of the repo) =====
landing/

# ===== Portable USB build output (generated by scripts/package-usb.*, contains node_modules) =====
hesi/

# 注：构建产物 `public/bundle.js` 与 `public/lazy-chunks/` 不再 ignore，
# 已在 git 树中跟踪（v0.7.8-fix 起），保证 GitHub Release 的 Source code 自动包含，
# 用户下载解压后即可 `npm install && npm start` 运行，无需 `npm run build`。
# 任何 source 变更后必须 `npm run build` 重建并 commit 对应产物（commit 前同步）。
