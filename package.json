  "scripts": {
    "start": "npm run check:server && node server.js",
    "dev": "npm run check:server && node --watch server.js",
    "build": "npm run check:server && npm run build:main && npm run build:lazy",
    "build:main": "npx esbuild public/main.js --bundle --outfile=public/bundle.js --format=iife --minify",
    "build:lazy": "node scripts/clean-lazy.cjs && npx esbuild public/lazy.js --bundle --outdir=public/lazy-chunks --format=esm --minify --splitting --entry-names=lazy-bundle --chunk-names=chunk-[hash]",
    "build:dev": "npm run check:server && npm run build:dev:main && npm run build:dev:lazy",
    "build:dev:main": "npx esbuild public/main.js --bundle --outfile=public/bundle.js --format=iife --sourcemap",
    "build:dev:lazy": "npx esbuild public/lazy.js --bundle --outdir=public/lazy-chunks --format=esm --sourcemap --splitting --entry-names=lazy-bundle --chunk-names=chunk-[hash]",
    "watch": "npx esbuild public/main.js --bundle --outfile=public/bundle.js --format=iife --sourcemap --watch &",
    "watch:lazy": "npx esbuild public/lazy.js --bundle --outdir=public/lazy-chunks --format=esm --sourcemap --splitting --entry-names=lazy-bundle --chunk-names=chunk-[hash] --watch",
    "check:server": "node scripts/check-server.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "mcp": "npm run check:server && node mcp-server.js",
    "mcp:dev": "npm run check:server && node --watch mcp-server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node -e \"if(process.env.NODE_ENV==='production')process.exit(0);try{require.resolve('husky');require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "lint-staged": "lint-staged",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --experimental-test-coverage",
    "prepublishOnly": "npm run build && npm test",
    "plans": "node plans/run-all.js",
    "plans:audit": "node plans/audit-acceptance.js",
    "format": "prettier --write \"**/*.js\" \"**/*.css\" \"**/*.json\" \"**/*.html\"",
    "format:check": "prettier --check \"**/*.js\" \"**/*.css\" \"**/*.json\" \"**/*.html\""
  },
  "lint-staged": {
    "server.js": [
      "eslint --fix",
      "node --check"
    ],
    "routes/**/*.js": [
      "eslint --fix",
      "node --check"
    ],
    "ws/**/*.js": [
      "eslint --fix",
      "node --check"
    ],
    "mcp/**/*.js": [
      "eslint --fix",
      "node --check"
    ],
    "mcp-server.js": [
      "eslint --fix",
      "node --check"
    ],
    "cli-discovery.js": [
      "eslint --fix",
      "node --check"
    ],
    "preset-loader.js": [
      "eslint --fix",
      "node --check"
    ],
    "rate-limiter.js": [
      "eslint --fix",
      "node --check"
    ],
    "ring-buffer.js": [
      "eslint --fix",
      "node --check"
    ],
    "ws-handler.js": [
      "eslint --fix",
      "node --check"
    ],
    "lib/**/*.js": [
      "eslint --fix",
      "node --check"
    ],
    "test/**/*.js": [
      "eslint --fix",
      "node --check"
    ],
    "plans/**/*.js": [
      "eslint --fix",
      "node --check"
    ],
    "public/**/*.js": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.9.5"
  }
